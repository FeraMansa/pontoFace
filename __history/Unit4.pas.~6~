unit Unit4;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Classes, System.Generics.Collections,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls,
  Vcl.Buttons, // <- ADICIONADO: para TBitBtn
  IdBaseComponent, IdComponent, IdCustomTCPServer, IdTCPServer, IdHTTPServer,
  IdContext, IdCustomHTTPServer, IdGlobal, IOUtils, DateUtils, System.StrUtils,
  System.NetEncoding,IdStack; // <- ADICIONADO: para Base64

type
  TDeviceInfo = class
  public
    SN: string;
    RegistryCode: string;
    Commands: TQueue<string>;
    constructor Create(const aSN: string);
    destructor Destroy; override;
  end;

  TForm4 = class(TForm)
    IdHTTPServer1: TIdHTTPServer;
    MemoLog: TMemo;
    BtnTestUser: TButton;
    BtnRequestLogs: TButton;
    edtPort: TEdit;
    Label1: TLabel;
    edtCmdSN: TEdit;
    Label2: TLabel;
    edtRawCmd: TEdit;
    btnSendRawCmd: TButton;
    // --- NOVO BOTÃO DE FACE
    BtnTestFace: TBitBtn;
    BtnTestFaceUrl: TBitBtn;
    // --- FIM
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure IdHTTPServer1CommandGet(AContext: TIdContext; ARequestInfo: TIdHTTPRequestInfo;
      AResponseInfo: TIdHTTPResponseInfo);
    procedure IdHTTPServer1CommandOther(AContext: TIdContext; ARequestInfo: TIdHTTPRequestInfo;
      AResponseInfo: TIdHTTPResponseInfo);
    procedure BtnTestUserClick(Sender: TObject);
    procedure BtnRequestLogsClick(Sender: TObject);
    procedure btnSendRawCmdClick(Sender: TObject);
    procedure BtnStopClick(Sender: TObject);
    procedure BtnStartClick(Sender: TObject);
    // --- HANDLER DO BOTÃO DE FACE
    procedure BtnTestFaceClick(Sender: TObject);
    procedure BtnTestFaceUrlClick(Sender: TObject);

    // --- FIM
  private
    FDevices: TObjectDictionary<string, TDeviceInfo>;
    FCmdCounter: Integer;
    function EnsureDevice(const SN: string): TDeviceInfo;
    function NewCmdID: Integer;
    function BuildQueryUsersCmd(cmdId: Integer): string;
    function BuildQueryTransactionsCmd(cmdId: Integer): string;
    procedure Log(const S: string);
    procedure HandleCData(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
    procedure HandleRegistry(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
    procedure HandleGetRequest(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
    procedure HandlePush(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
    procedure HandleQueryData(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
    procedure HandleDeviceCommandEndpoint(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
    function GetRTDataStr: string;
    procedure SavePhotoFromStream(ARequestInfo: TIdHTTPRequestInfo; const SaveFolder: string);
  public
  end;

var
  Form4: TForm4;

implementation
uses
Vcl.Imaging.jpeg;

{$R *.dfm}

{ TDeviceInfo }

constructor TDeviceInfo.Create(const aSN: string);
begin
  inherited Create;
  SN := aSN;
  RegistryCode := '2C898CAA' + SN;
  Commands := TQueue<string>.Create;
end;

destructor TDeviceInfo.Destroy;
begin
  Commands.Free;
  inherited;
end;

{ TForm4 }

procedure TForm4.FormCreate(Sender: TObject);
begin
  MemoLog.Clear;
  edtPort.Text := '8011';
  FDevices := TObjectDictionary<string, TDeviceInfo>.Create([doOwnsValues]);
  FCmdCounter := 1000;
  IdHTTPServer1.DefaultPort := StrToIntDef(edtPort.Text, 8011);
end;

procedure TForm4.FormDestroy(Sender: TObject);
begin
  IdHTTPServer1.Active := False;
  FreeAndNil(FDevices);
  Log('Servidor parado.');
end;

procedure TForm4.Log(const S: string);
begin
  MemoLog.Lines.Add(FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + ' - ' + S);
  Application.ProcessMessages;
end;

function TForm4.EnsureDevice(const SN: string): TDeviceInfo;
var
  sSN: string;
begin
  sSN := SN;
  if sSN = '' then
    sSN := 'UNKNOWN';

  if not FDevices.TryGetValue(sSN, Result) then
  begin
    Result := TDeviceInfo.Create(sSN);
    FDevices.Add(sSN, Result);
    Log('Novo dispositivo adicionado localmente: ' + sSN + ' -> RegistryCode=' + Result.RegistryCode);
  end;
end;

function TForm4.NewCmdID: Integer;
begin
  Inc(FCmdCounter);
  Result := FCmdCounter;
end;

function TForm4.BuildQueryUsersCmd(cmdId: Integer): string;
begin
  Result := Format('C:%d:DATA QUERY tablename=user,fielddesc=*,filter=*', [cmdId]);
end;

function TForm4.BuildQueryTransactionsCmd(cmdId: Integer): string;
begin
  Result := Format('C:%d:DATA QUERY tablename=transaction,fielddesc=*,filter=*', [cmdId]);
end;

procedure TForm4.BtnStartClick(Sender: TObject);
begin
  IdHTTPServer1.Active := True;
  Log('Servidor iniciado na porta ' + IntToStr(IdHTTPServer1.DefaultPort));
end;

procedure TForm4.BtnStopClick(Sender: TObject);
begin
  IdHTTPServer1.Active := False;
  Log('Servidor parado ' + IntToStr(IdHTTPServer1.DefaultPort));
end;

procedure TForm4.BtnTestUserClick(Sender: TObject);
var
  SN: string;
  dev: TDeviceInfo;
  id: Integer;
  cmd: string;
begin
  SN := Trim(edtCmdSN.Text);
  if SN = '' then SN := 'CP9L231460658';
  dev := EnsureDevice(SN);
  id := NewCmdID;

  cmd := Format('C:%d:DATA UPDATE user ' +
         'CardNo=12345'#9 +
         'Pin=1'#9 +
         'Password=234'#9 +
         'Name=Gustavo'#9 +
         'Privilege=0'#9 +
         'Group=1'#9 +
         'TZ=0000000000000000', [id]);

  dev.Commands.Enqueue(cmd);
  Log('TestUser: enfileirado para ' + SN + ' -> ' + cmd);
end;

procedure TForm4.BtnRequestLogsClick(Sender: TObject);
var
  SN: string;
  dev: TDeviceInfo;
  id: Integer;
  cmd: string;
begin
  SN := Trim(edtCmdSN.Text);
  if SN = '' then SN := 'CP9L231460658';
  dev := EnsureDevice(SN);
  id := NewCmdID;
  cmd := BuildQueryTransactionsCmd(id);
  dev.Commands.Enqueue(cmd);
  Log('RequestLogs: enfileirado para ' + SN + ' -> ' + cmd);
end;

procedure TForm4.btnSendRawCmdClick(Sender: TObject);
var
  raw, targetSN: string;
  dev: TDeviceInfo;
  pair: TPair<string, TDeviceInfo>;
begin
  raw := Trim(edtRawCmd.Text);
  targetSN := Trim(edtCmdSN.Text);
  if raw = '' then
  begin
    Log('Raw command vazio — nada enfileirado.');
    Exit;
  end;

  if targetSN = '' then
  begin
    if FDevices.Count = 0 then
    begin
      Log('Sem dispositivos registrados — não é possível broadcast.');
      Exit;
    end;
    for pair in FDevices do
    begin
      pair.Value.Commands.Enqueue(raw);
      Log('Broadcast enfileirado para ' + pair.Key + ' -> ' + raw);
    end;
  end
  else
  begin
    dev := EnsureDevice(targetSN);
    dev.Commands.Enqueue(raw);
    Log('Enfileirado raw para ' + targetSN + ' -> ' + raw);
  end;
end;

procedure TForm4.IdHTTPServer1CommandGet(AContext: TIdContext; ARequestInfo: TIdHTTPRequestInfo;
  AResponseInfo: TIdHTTPResponseInfo);
begin
  IdHTTPServer1CommandOther(AContext, ARequestInfo, AResponseInfo);
end;

procedure TForm4.HandleCData(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
var
  SN, table, body: string;
  ms: TMemoryStream;
  bytes: TBytes;
begin
  SN := ARequestInfo.Params.Values['SN'];
  table := ARequestInfo.Params.Values['table'];
  Log(Format('/iclock/cdata recebido: SN=%s, table=%s, method=%s', [SN, table, ARequestInfo.Command]));

  if SameText(ARequestInfo.Command, 'POST') and Assigned(ARequestInfo.PostStream) then
  begin
    ARequestInfo.PostStream.Position := 0;
    ms := TMemoryStream.Create;
    try
      ms.LoadFromStream(ARequestInfo.PostStream);
      SetLength(bytes, ms.Size);
      if ms.Size > 0 then
      begin
        ms.Position := 0;
        ms.ReadBuffer(bytes[0], ms.Size);
        body := TEncoding.UTF8.GetString(bytes);
      end else
        body := '';
    finally
      ms.Free;
    end;

    Log('Body (raw, first 2000 chars): ' + Copy(body, 1, 2000));

    if SameText(table, 'ATTLOG') then
    begin
      TFile.AppendAllText(TPath.Combine(ExtractFilePath(ParamStr(0)), 'attlog.txt'),
        FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + ' - ' + body + sLineBreak, TEncoding.UTF8);
      Log('ATTLOG salvo em attlog.txt');
    end
    else if SameText(table, 'ATTPHOTO') then
    begin
      SavePhotoFromStream(ARequestInfo, TPath.Combine(ExtractFilePath(ParamStr(0)), 'photos'));
    end
    else
    begin
      TFile.AppendAllText(TPath.Combine(ExtractFilePath(ParamStr(0)), 'cdata_other.txt'),
        FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + ' - table=' + table + sLineBreak + body + sLineBreak + '----' + sLineBreak, TEncoding.UTF8);
    end;
  end;

  AResponseInfo.ResponseNo := 200;
  AResponseInfo.ContentType := 'text/plain';
  AResponseInfo.ContentText := 'OK';
end;

procedure TForm4.HandleRegistry(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
var
  SN: string;
  dev: TDeviceInfo;
begin
  SN := ARequestInfo.Params.Values['SN'];
  dev := EnsureDevice(SN);
  AResponseInfo.ResponseNo := 200;
  AResponseInfo.ContentType := 'text/plain';
  AResponseInfo.ContentText := 'RegistryCode=' + dev.RegistryCode + sLineBreak;
  Log(Format('/iclock/registry recebido de %s, enviando RegistryCode=%s', [SN, dev.RegistryCode]));
end;

procedure TForm4.HandleGetRequest(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
var
  SN: string;
  dev: TDeviceInfo;
  cmd: string;
begin
  SN := ARequestInfo.Params.Values['SN'];
  dev := EnsureDevice(SN);
  Log(Format('/iclock/getrequest recebido de %s (fila=%d)', [SN, dev.Commands.Count]));
  if dev.Commands.Count > 0 then
  begin
    cmd := dev.Commands.Dequeue;
    AResponseInfo.ResponseNo := 200;
    AResponseInfo.ContentType := 'text/plain';
    AResponseInfo.ContentText := cmd;
    Log('Enviado comando para dispositivo: ' + cmd);
  end
  else
  begin
    AResponseInfo.ResponseNo := 200;
    AResponseInfo.ContentType := 'text/plain';
    AResponseInfo.ContentText := 'OK';
  end;
end;

procedure TForm4.HandlePush(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
begin
  Log('/iclock/push solicitado por ' + ARequestInfo.Params.Values['SN']);
  AResponseInfo.ResponseNo := 200;
  AResponseInfo.ContentType := 'text/plain';
  AResponseInfo.ContentText :=
    'ServerVersion=3.0.1' + sLineBreak +
    'ServerName=ADMS' + sLineBreak +
    'PushVersion=3.0.1' + sLineBreak +
    'ErrorDelay=5' + sLineBreak +
    'RequestDelay=1' + sLineBreak +
    'TransTimes=00:00;14:00' + sLineBreak +
    'TransInterval=1' + sLineBreak +
    'TransTables=User Transaction' + sLineBreak +
    'Realtime=1' + sLineBreak +
    'SessionID=' + EnsureDevice(ARequestInfo.Params.Values['SN']).RegistryCode + sLineBreak +
    'TimeoutSec=10';
end;

procedure TForm4.HandleQueryData(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
var
  SN, tablename, body: string;
  ms: TMemoryStream;
  bytes: TBytes;
  fname: string;
begin
  SN := ARequestInfo.Params.Values['SN'];
  tablename := ARequestInfo.Params.Values['tablename'];
  Log(Format('/iclock/querydata recebido: SN=%s tablename=%s params=%s', [SN, tablename, ARequestInfo.UnparsedParams]));

  body := '';
  if Assigned(ARequestInfo.PostStream) then
  begin
    ARequestInfo.PostStream.Position := 0;
    ms := TMemoryStream.Create;
    try
      ms.LoadFromStream(ARequestInfo.PostStream);
      SetLength(bytes, ms.Size);
      if ms.Size > 0 then
      begin
        ms.Position := 0;
        ms.ReadBuffer(bytes[0], ms.Size);
        body := TEncoding.UTF8.GetString(bytes);
      end;
    finally
      ms.Free;
    end;
  end;

  Log('querydata body raw (first 2000 chars): ' + Copy(body, 1, 2000));

  if tablename = '' then
    fname := 'querydata_raw.txt'
  else
    fname := tablename + '_querydata.txt';

  TFile.AppendAllText(TPath.Combine(ExtractFilePath(ParamStr(0)), fname),
    FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + ' - SN=' + SN + sLineBreak + body + sLineBreak + '----' + sLineBreak, TEncoding.UTF8);

  AResponseInfo.ResponseNo := 200;
  AResponseInfo.ContentType := 'text/plain';
  AResponseInfo.ContentText := 'OK';
  Log('querydata gravado em ' + fname);
end;

procedure TForm4.HandleDeviceCommandEndpoint(ARequestInfo: TIdHTTPRequestInfo; AResponseInfo: TIdHTTPResponseInfo);
var
  rawBody: string;
  ms: TMemoryStream;
  bytes: TBytes;
  targetSN: string;
  dev: TDeviceInfo;
  pair: TPair<string, TDeviceInfo>;
begin
  targetSN := ARequestInfo.Params.Values['SN'];
  rawBody := '';
  if Assigned(ARequestInfo.PostStream) then
  begin
    ARequestInfo.PostStream.Position := 0;
    ms := TMemoryStream.Create;
    try
      ms.LoadFromStream(ARequestInfo.PostStream);
      SetLength(bytes, ms.Size);
      if ms.Size > 0 then
      begin
        ms.Position := 0;
        ms.ReadBuffer(bytes[0], ms.Size);
        rawBody := TEncoding.UTF8.GetString(bytes);
      end;
    finally
      ms.Free;
    end;
  end;

  Log(Format('/device/command recebido (SN=%s) body(2000)=%s', [targetSN, Copy(rawBody,1,2000)]));

  if Trim(rawBody) = '' then
  begin
    AResponseInfo.ResponseNo := 400;
    AResponseInfo.ContentText := 'Empty body';
    Exit;
  end;

  if StartsText('C:', Trim(rawBody)) then
  begin
    if targetSN <> '' then
    begin
      dev := EnsureDevice(targetSN);
      dev.Commands.Enqueue(rawBody);
      AResponseInfo.ResponseNo := 200;
      AResponseInfo.ContentText := 'OK enfileirado para ' + targetSN;
      Log('Comando enfileirado para ' + targetSN + ' -> ' + rawBody);
    end
    else
    begin
      if FDevices.Count = 0 then
      begin
        AResponseInfo.ResponseNo := 400;
        AResponseInfo.ContentText := 'No devices registered';
        Log('device/command: tentativa de broadcast sem devices registrados');
        Exit;
      end;
      for pair in FDevices do
      begin
        pair.Value.Commands.Enqueue(rawBody);
        Log('Broadcast enfileirado para ' + pair.Key + ' -> ' + rawBody);
      end;
      AResponseInfo.ResponseNo := 200;
      AResponseInfo.ContentText := 'OK broadcasted to ' + IntToStr(FDevices.Count) + ' devices';
    end;
    Exit;
  end;

  AResponseInfo.ResponseNo := 200;
  AResponseInfo.ContentText := 'OK (received)';
end;

function TForm4.GetRTDataStr: string;
var
  dt: TDateTime;
  y, mo, d, h, mi, s, ms: Word;
  seconds: Int64;
begin
  dt := Now;
  DecodeDate(dt, y, mo, d);
  DecodeTime(dt, h, mi, s, ms);
  seconds := (((y - 2000) * 12 * 31) + ((mo - 1) * 31) + d - 1) * 86400 + ((h + 3) * 60 + mi) * 60 + s;
  Result := Format('DateTime=%d,MachineTZ=-0300,ServerTZ=-0300', [seconds]);
end;

procedure TForm4.IdHTTPServer1CommandOther(AContext: TIdContext; ARequestInfo: TIdHTTPRequestInfo;
  AResponseInfo: TIdHTTPResponseInfo);
var
  doc: string;
begin
  doc := LowerCase(ARequestInfo.Document);
  Log(Format('REQUEST -> %s  method=%s params=%s', [doc, ARequestInfo.Command, ARequestInfo.UnparsedParams]));

  if doc = '/iclock/cdata' then
    HandleCData(ARequestInfo, AResponseInfo)
  else if doc = '/iclock/registry' then
    HandleRegistry(ARequestInfo, AResponseInfo)
  else if doc = '/iclock/getrequest' then
    HandleGetRequest(ARequestInfo, AResponseInfo)
  else if doc = '/iclock/push' then
    HandlePush(ARequestInfo, AResponseInfo)
  else if doc = '/iclock/querydata' then
    HandleQueryData(ARequestInfo, AResponseInfo)
  else if doc = '/iclock/rtdata' then
  begin
    AResponseInfo.ResponseNo := 200;
    AResponseInfo.ContentType := 'text/plain';
    AResponseInfo.ContentText := GetRTDataStr;
    Log('/iclock/rtdata respondido');
  end
  else if doc = '/device/command' then
    HandleDeviceCommandEndpoint(ARequestInfo, AResponseInfo)
  // --- NOVO: aceitar o callback /iclock/devicecmd (status/respostas do device)
  else if doc = '/iclock/devicecmd' then
  begin
    // Registrar o que o equipamento postou (status do comando, erros, template de face quando PostBackTmpFlag=1, etc.)
    var body: string := '';
    if Assigned(ARequestInfo.PostStream) then
    begin
      ARequestInfo.PostStream.Position := 0;
      var ss := TStringStream.Create('', TEncoding.UTF8);
      try
        ss.LoadFromStream(ARequestInfo.PostStream);
        body := ss.DataString;
      finally
        ss.Free;
      end;
    end;
    Log('DEVICECMD body (first 2000): ' + Copy(body,1,2000));
    AResponseInfo.ResponseNo := 200;
    AResponseInfo.ContentType := 'text/plain';
    AResponseInfo.ContentText := 'OK';
  end
  // --- FIM NOVO
  else
  begin
    AResponseInfo.ResponseNo := 404;
    AResponseInfo.ContentType := 'text/plain';
    AResponseInfo.ContentText := 'Not Found';
    Log('404 -> ' + doc);
  end;
end;

procedure TForm4.SavePhotoFromStream(ARequestInfo: TIdHTTPRequestInfo; const SaveFolder: string);
var
  ms: TMemoryStream;
  buf: TBytes;
  idxNul: Integer;
  headerPart, pinName, savePath, tmpStr: string;
  photoDataPos, p: Int64;
begin
  if not Assigned(ARequestInfo.PostStream) then Exit;

  ms := TMemoryStream.Create;
  try
    ARequestInfo.PostStream.Position := 0;
    ms.LoadFromStream(ARequestInfo.PostStream);
    SetLength(buf, ms.Size);
    ms.Position := 0;
    if ms.Size > 0 then
      ms.ReadBuffer(buf[0], ms.Size);

    idxNul := -1;
    for p := 0 to Length(buf)-1 do
      if buf[p] = 0 then begin idxNul := p; Break; end;

    if idxNul = -1 then
    begin
      if not TDirectory.Exists(SaveFolder) then TDirectory.CreateDirectory(SaveFolder);
      savePath := TPath.Combine(SaveFolder, Format('photo_%s.jpg', [FormatDateTime('yyyymmdd_hhnnss', Now)]));
      TFile.WriteAllBytes(savePath, buf);
      Log('Foto salva (binario inteiro): ' + savePath);
      Exit;
    end;

    headerPart := TEncoding.UTF8.GetString(buf, 0, idxNul);
    pinName := '';
    tmpStr := headerPart;
    p := Pos('PIN=', tmpStr);
    if p > 0 then
    begin
      tmpStr := Copy(tmpStr, p + 4, MaxInt);
      p := Pos(' ', tmpStr);
      if p = 0 then p := Pos(#9, tmpStr);
      if p = 0 then p := Length(tmpStr)+1;
      pinName := Trim(Copy(tmpStr, 1, p-1));
    end;
    if pinName = '' then
      pinName := Format('photo_%s', [FormatDateTime('yyyymmdd_hhnnss', Now)]);

    if not TDirectory.Exists(SaveFolder) then TDirectory.CreateDirectory(SaveFolder);

    photoDataPos := idxNul + 1;
    savePath := TPath.Combine(SaveFolder, pinName + '.jpg');
    TFile.WriteAllBytes(savePath, Copy(buf, photoDataPos, Length(buf)-photoDataPos));
    Log('Foto salva: ' + savePath);
  finally
    ms.Free;
  end;
end;

procedure TForm4.BtnTestFaceClick(Sender: TObject);
var
  SN, pin, base64Path: string;
  dev: TDeviceInfo;
  id: Integer;
  b64, cmd: string;
  size: Integer;
begin
  SN := Trim(edtCmdSN.Text);
  if SN = '' then
    SN := 'CP9L231460658';
  pin := '1';
  id := 4;

  // Caminho completo para base64.txt
  base64Path := TPath.Combine(ExtractFilePath(ParamStr(0)), 'base64.txt');

  if not TFile.Exists(base64Path) then
  begin
    Log('Arquivo base64.txt não encontrado: ' + base64Path);
    Exit;
  end;

  try
    b64 := TFile.ReadAllText(base64Path, TEncoding.UTF8);
  except
    on E: Exception do
    begin
      Log('Erro ao ler base64.txt: ' + E.Message);
      Exit;
    end;
  end;

  // Remove quebras de linha
  b64 := StringReplace(b64, sLineBreak, '', [rfReplaceAll]);
  b64 := StringReplace(b64, #13, '', [rfReplaceAll]);
  b64 := StringReplace(b64, #10, '', [rfReplaceAll]);
  b64 := Trim(b64);

  if b64 = '' then
  begin
    Log('O arquivo base64.txt está vazio.');
    Exit;
  end;

  size := Length(b64);

  // Comando completo conforme documentação ZKTeco
  cmd :=

     Format(
      'C:%d:DATA UPDATE biophoto ' +  // <-- tudo minúsculo aqui
      'PIN=%s'#9 +
      'Content=%s',                   // apenas PIN e Content
      [id, pin, b64]
    );


  dev := EnsureDevice(SN);
  dev.Commands.Enqueue(cmd);

  Log('TestFace(Base64): comando enfileirado para ' + SN);
  Log(Format('→ Enviado DATA UPDATE BIOPHOTO (PIN=%s, %d bytes Base64)', [pin, size]));
end;











procedure TForm4.BtnTestFaceUrlClick(Sender: TObject);
var
  SN, pin, ip, photoUrl, jpgPath, photosDir, destPath: string;
  dev: TDeviceInfo;
  id: Integer;
  jpgBytes: TBytes;
  size: Integer;
begin
  SN := Trim(edtCmdSN.Text);
  if SN = '' then
    SN := 'CP9L231460658';

  pin := '1';
  id := 4;
  jpgPath := 'C:\face_tem.jpg';

  if not TFile.Exists(jpgPath) then
  begin
    Log('Arquivo não encontrado: ' + jpgPath);
    Exit;
  end;

  // Copia imagem para pasta "photos" no executável
  photosDir := TPath.Combine(ExtractFilePath(ParamStr(0)), 'photos');
  if not TDirectory.Exists(photosDir) then
    TDirectory.CreateDirectory(photosDir);

  destPath := TPath.Combine(photosDir, 'face_tem.jpg');
  TFile.Copy(jpgPath, destPath, True);

  // Obtém IP local (requer IdStack)
  ip := GStack.LocalAddress;
  if ip = '' then
    ip := '127.0.0.1';

  photoUrl := Format('http://10.1.1.99:8080/bpc/files/face_tem.jpg', [ip, edtPort.Text]);

  // Calcula tamanho do arquivo original
  jpgBytes := TFile.ReadAllBytes(jpgPath);
  size := Length(jpgBytes);

  // Comando completo com todos os parâmetros obrigatórios
  var cmd := Format(
    'C:%d:DATA UPDATE BIOPHOTO'#13#10 +
    'PIN=%s'#9'Type=9'#9'No=0'#9'Index=0'#9'Size=%d'#9'Url=%s'#9'Format=1'#9'PostBackTmpFlag=0',
    [id, pin, size, photoUrl]
  );

  dev := EnsureDevice(SN);
  dev.Commands.Enqueue(cmd);

  Log('TestFace(URL): comando BIOPHOTO enfileirado para ' + SN);
  Log('→ Enviado DATA UPDATE BIOPHOTO (via URL, PIN=' + pin + ', ' + IntToStr(size) + ' bytes)');
end;



